# Скопируйте в .env и заполните.
# Ключ создаётся в админке Keitaro: Профиль → API ключи → Создать новый ключ.
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=

# Имя группы и источника: если в Keitaro их нет, они создаются автоматически.
KEITARO_GROUP_NAME=FORTESTS
KEITARO_SOURCE_NAME=FORTESTS

# Префикс имён кампаний (по требованию ТЗ: test_фамилия_)
CAMPAIGN_NAME_PREFIX=test_mkrtchyan_

# Куда редиректит первый поток (гео-фильтр)
GOOGLE_REDIRECT_URL=https://google.com

# БД обёртки (история действий)
DATABASE_URL=sqlite:///./app.db
